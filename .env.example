# =============================================================================
# any-sync-dockercompose configuration
# Copy this file to .env and adjust values as needed.
# =============================================================================


# -----------------------------------------------------------------------------
# Service versions
# -----------------------------------------------------------------------------
ANY_SYNC_NODE_VERSION=v0.13.1
ANY_SYNC_FILENODE_VERSION=v0.13.0
ANY_SYNC_COORDINATOR_VERSION=v0.13.0
ANY_SYNC_CONSENSUSNODE_VERSION=v0.13.0
ANY_SYNC_TOOLS_VERSION=latest
ANYTYPE_CLI_VERSION=latest

MONGO_VERSION=7.0.28
REDIS_VERSION=7.2.0-v6
GARAGE_VERSION=v2.3.0

# Used only by the one-off "migrate" profile (see the Upgrade Guide wiki page).
# MinIO is no longer part of the running stack.
MINIO_LEGACY_VERSION=RELEASE.2025-09-07T16-13-09Z.hotfix.7aa24e772
RCLONE_VERSION=1.71.1


# -----------------------------------------------------------------------------
# External network access
# Defines the host address that services bind to externally.
# Use "127.0.0.1" for local-only access, or specify a LAN/public IP.
# Multiple hosts can be listed space-separated (see commented example).
# -----------------------------------------------------------------------------
EXTERNAL_LISTEN_HOSTS="127.0.0.1"
#EXTERNAL_LISTEN_HOSTS="192.168.1.2 10.0.0.2"


# -----------------------------------------------------------------------------
# any-sync-node (sync nodes 1–3)
# Each node exposes a TCP port and a QUIC port for transport,
# plus an internal API and metrics endpoint.
# -----------------------------------------------------------------------------
ANY_SYNC_NODE_1_HOST=any-sync-node-1
ANY_SYNC_NODE_1_PORT=1001
ANY_SYNC_NODE_1_ADDRESSES=${ANY_SYNC_NODE_1_HOST}:${ANY_SYNC_NODE_1_PORT}
ANY_SYNC_NODE_1_QUIC_PORT=1011
ANY_SYNC_NODE_1_QUIC_ADDRESSES=${ANY_SYNC_NODE_1_HOST}:${ANY_SYNC_NODE_1_QUIC_PORT}
ANY_SYNC_NODE_1_API_SERVER_ADDR=127.0.0.1:8081
ANY_SYNC_NODE_1_METRIC_ADDR=127.0.0.1:8001

ANY_SYNC_NODE_2_HOST=any-sync-node-2
ANY_SYNC_NODE_2_PORT=1002
ANY_SYNC_NODE_2_ADDRESSES=${ANY_SYNC_NODE_2_HOST}:${ANY_SYNC_NODE_2_PORT}
ANY_SYNC_NODE_2_QUIC_PORT=1012
ANY_SYNC_NODE_2_QUIC_ADDRESSES=${ANY_SYNC_NODE_2_HOST}:${ANY_SYNC_NODE_2_QUIC_PORT}
ANY_SYNC_NODE_2_API_SERVER_ADDR=127.0.0.1:8082
ANY_SYNC_NODE_2_METRIC_ADDR=127.0.0.1:8002

ANY_SYNC_NODE_3_HOST=any-sync-node-3
ANY_SYNC_NODE_3_PORT=1003
ANY_SYNC_NODE_3_ADDRESSES=${ANY_SYNC_NODE_3_HOST}:${ANY_SYNC_NODE_3_PORT}
ANY_SYNC_NODE_3_QUIC_PORT=1013
ANY_SYNC_NODE_3_QUIC_ADDRESSES=${ANY_SYNC_NODE_3_HOST}:${ANY_SYNC_NODE_3_QUIC_PORT}
ANY_SYNC_NODE_3_API_SERVER_ADDR=127.0.0.1:8083
ANY_SYNC_NODE_3_METRIC_ADDR=127.0.0.1:8003


# -----------------------------------------------------------------------------
# any-sync-coordinator
# Manages space membership and coordinates node topology.
# -----------------------------------------------------------------------------
ANY_SYNC_COORDINATOR_HOST=any-sync-coordinator
ANY_SYNC_COORDINATOR_PORT=1004
ANY_SYNC_COORDINATOR_ADDRESSES=${ANY_SYNC_COORDINATOR_HOST}:${ANY_SYNC_COORDINATOR_PORT}
ANY_SYNC_COORDINATOR_QUIC_PORT=1014
ANY_SYNC_COORDINATOR_QUIC_ADDRESSES=${ANY_SYNC_COORDINATOR_HOST}:${ANY_SYNC_COORDINATOR_QUIC_PORT}
ANY_SYNC_COORDINATOR_METRIC_ADDR=127.0.0.1:8004

# Default per-space limits enforced by the coordinator
ANY_SYNC_COORDINATOR_DEFAULT_LIMITS_SPACE_MEMBERS_READ=1000
ANY_SYNC_COORDINATOR_DEFAULT_LIMITS_SPACE_MEMBERS_WRITE=1000
ANY_SYNC_COORDINATOR_DEFAULT_LIMITS_SHARED_SPACES_LIMIT=1000


# -----------------------------------------------------------------------------
# any-sync-filenode
# Handles binary file (blob) storage, backed by S3 (Garage).
# -----------------------------------------------------------------------------
ANY_SYNC_FILENODE_HOST=any-sync-filenode
ANY_SYNC_FILENODE_PORT=1005
ANY_SYNC_FILENODE_ADDRESSES=${ANY_SYNC_FILENODE_HOST}:${ANY_SYNC_FILENODE_PORT}
ANY_SYNC_FILENODE_QUIC_PORT=1015
ANY_SYNC_FILENODE_QUIC_ADDRESSES=${ANY_SYNC_FILENODE_HOST}:${ANY_SYNC_FILENODE_QUIC_PORT}
ANY_SYNC_FILENODE_METRIC_ADDR=127.0.0.1:8005

# Default per-account storage quota in bytes (1 TiB)
ANY_SYNC_FILENODE_DEFAULT_LIMIT=1099511627776


# -----------------------------------------------------------------------------
# any-sync-consensusnode
# Provides consensus (Raft-based) for coordinator operations.
# -----------------------------------------------------------------------------
ANY_SYNC_CONSENSUSNODE_HOST=any-sync-consensusnode
ANY_SYNC_CONSENSUSNODE_PORT=1006
ANY_SYNC_CONSENSUSNODE_ADDRESSES=${ANY_SYNC_CONSENSUSNODE_HOST}:${ANY_SYNC_CONSENSUSNODE_PORT}
ANY_SYNC_CONSENSUSNODE_QUIC_PORT=1016
ANY_SYNC_CONSENSUSNODE_QUIC_ADDRESSES=${ANY_SYNC_CONSENSUSNODE_HOST}:${ANY_SYNC_CONSENSUSNODE_QUIC_PORT}
ANY_SYNC_CONSENSUSNODE_METRIC_ADDR=127.0.0.1:8006


# -----------------------------------------------------------------------------
# Anytype CLI / bot account
# gRPC and HTTP API ports for the built-in Anytype client/bot.
# -----------------------------------------------------------------------------
ANYTYPE_CLI_GRPC_PORT=31010
ANYTYPE_CLI_GRPC_WEB_PORT=31011
ANYTYPE_CLI_API_PORT=31012
ANYTYPE_CLI_ACCOUNT_NAME=anytype-bot


# -----------------------------------------------------------------------------
# MongoDB (replica set)
# Used by coordinator and consensusnode for persistent metadata storage.
# -----------------------------------------------------------------------------
MONGO_1_PORT=27001
MONGO_CONNECT=mongodb://mongo-1:${MONGO_1_PORT}
MONGO_REPLICA_SET=rs0


# -----------------------------------------------------------------------------
# Redis
# Used as a cache / pub-sub broker by sync nodes.
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL="redis://${REDIS_HOST}:${REDIS_PORT}?dial_timeout=3&read_timeout=6s"
REDIS_MAXMEMORY=256mb


# -----------------------------------------------------------------------------
# S3-compatible object storage (Garage)
# Stores files managed by any-sync-filenode.
# Replaces MinIO — see the Upgrade Guide wiki page before upgrading an existing install.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=any_sync_access_key
AWS_SECRET_ACCESS_KEY=any_sync_secret_key

# Internal address of the S3 service. Point it to an external S3-compatible
# storage if you do not want to use the bundled Garage container.
# The port Garage listens on is set in garage/garage.toml.
S3_ENDPOINT=http://garage:3900
S3_BUCKET=any-sync-files
S3_REGION=us-east-1

# Garage cluster RPC secret (64 hex chars). Port 3901 is not published to the host,
# so the default is safe for a single-node setup. Change it if you expose that port:
#   openssl rand -hex 32
GARAGE_RPC_SECRET=6b6579206f6e6c792075736564206c6f63616c6c7920627920612073696e676c

# Name of the old MinIO bucket, used by the one-off migration from MinIO.
# Only change this if you customized MINIO_BUCKET before the migration.
S3_LEGACY_BUCKET=minio-bucket


# -----------------------------------------------------------------------------
# Storage & resource limits
# -----------------------------------------------------------------------------
# Host path where all service data volumes are persisted
STORAGE_DIR="./storage"

# Memory limit applied to each any-sync daemon container
ANY_SYNC_DAEMONS_MEMORY_LIMIT=500M
